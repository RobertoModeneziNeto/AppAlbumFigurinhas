<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppAlbumFigurinhas.MainPage"
             BackgroundColor="#0D6E3F">

    <Grid RowDefinitions="*, Auto">

        <!-- CONTEÚDO PRINCIPAL -->
        <ScrollView Grid.Row="0">
            <StackLayout Padding="20" Spacing="0">

                <!-- Imagem temática -->
                <Image Source="copa_banner.png"
                       HeightRequest="180"
                       Aspect="AspectFill"
                       Margin="0,10,0,0"/>

                <!-- Nome do App -->
                <Label Text="🏆 Figurinhas Copa 2026"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       Margin="0,16,0,4"/>

                <Label Text="Gerencie sua coleção"
                       FontSize="14"
                       TextColor="#A8D5B5"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,30"/>

                <!-- Botão Cadastro -->
                <Frame BackgroundColor="#FFD700"
                       CornerRadius="16"
                       Padding="0"
                       Margin="0,0,0,16"
                       HasShadow="True">
                    <Button Text="➕  Cadastrar Figurinha"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0D6E3F"
                            BackgroundColor="Transparent"
                            Clicked="btnCadastrar_Clicked"
                            HeightRequest="60"/>
                </Frame>

                <!-- Botão Lista -->
                <Frame BackgroundColor="White"
                       CornerRadius="16"
                       Padding="0"
                       Margin="0,0,0,16"
                       HasShadow="True">
                    <Button Text="📋  Lista de Figurinhas"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#0D6E3F"
                            BackgroundColor="Transparent"
                            Clicked="btnLista_Clicked"
                            HeightRequest="60"/>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- RODAPÉ -->
        <StackLayout Grid.Row="1"
                     BackgroundColor="#0A5530"
                     Padding="10">
            <Label Text="v1.0.0"
                   TextColor="#A8D5B5"
                   FontSize="12"
                   HorizontalTextAlignment="Center"/>
            <Label Text="Seu Nome | Nome do Colega"
                   TextColor="#A8D5B5"
                   FontSize="12"
                   HorizontalTextAlignment="Center"/>
        </StackLayout>

    </Grid>
</ContentPage>