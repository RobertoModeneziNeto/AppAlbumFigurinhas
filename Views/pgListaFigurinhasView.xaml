<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppAlbumFigurinhas.Views.pgListaFigurinhasView"
             Title="Lista de Figurinhas"
             BackgroundColor="#0D6E3F">
    <Grid RowDefinitions="Auto, *">

        <!-- FILTROS -->
        <StackLayout Grid.Row="0"
                     BackgroundColor="#0A5530"
                     Padding="12" Spacing="8">

            <Label Text="🔍 Filtros"
                   TextColor="#FFD700"
                   FontSize="15"
                   FontAttributes="Bold"/>

            <Entry x:Name="txtFiltroNome"
                   Placeholder="Buscar por nome..."
                   PlaceholderColor="#A8D5B5"
                   TextColor="White"
                   BackgroundColor="#0D6E3F"
                   TextChanged="Filtro_Changed"/>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="chkFiltroObtidas"
                          Color="#FFD700"
                          CheckedChanged="Filtro_Changed"/>
                <Label Text="Apenas adquiridas ✅"
                       TextColor="White"
                       VerticalOptions="Center"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="chkFiltroDesejadas"
                          Color="#FFD700"
                          CheckedChanged="Filtro_Changed"/>
                <Label Text="Apenas desejadas ❤️"
                       TextColor="White"
                       VerticalOptions="Center"/>
            </StackLayout>

        </StackLayout>

        <!-- LISTVIEW -->
        <ListView x:Name="lsvFigurinhas"
                  Grid.Row="1"
                  BackgroundColor="Transparent"
                  SeparatorVisibility="None"
                  RowHeight="110">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame BackgroundColor="#0A5530"
                               CornerRadius="12"
                               Margin="10,6"
                               Padding="8"
                               HasShadow="True">
                            <StackLayout Orientation="Horizontal" Spacing="8">

                                <!-- Imagem -->
                                <Image Source="{Binding DirImagem}"
                                       WidthRequest="70"
                                       HeightRequest="90"
                                       Aspect="AspectFill"/>

                                <!-- Dados -->
                                <StackLayout HorizontalOptions="FillAndExpand"
                                             VerticalOptions="Center"
                                             Spacing="2">
                                    <Label Text="{Binding NomeJogador}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="15"/>
                                    <Label Text="{Binding Selecao}"
                                           TextColor="#A8D5B5"
                                           FontSize="13"/>
                                    <Label Text="{Binding TipoFigurinha}"
                                           TextColor="#FFD700"
                                           FontSize="12"/>
                                </StackLayout>

                                <!-- Ícones de ação -->
                                <StackLayout VerticalOptions="Center"
                                             Spacing="8"
                                             Padding="4">

                                    <!-- Check (Obtido) -->
                                    <Image Source="{Binding IconeCheck}"
                                           WidthRequest="28" HeightRequest="28">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="tapCheck_Tapped"
                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!-- Coração (Desejado) -->
                                    <Image Source="{Binding IconeCoracao}"
                                           WidthRequest="28" HeightRequest="28">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="tapCoracao_Tapped"
                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <!-- Lixeira -->
                                    <Image Source="trash.png"
                                           WidthRequest="28"
                                           HeightRequest="28">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="tapDeletar_Tapped"
                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</ContentPage>